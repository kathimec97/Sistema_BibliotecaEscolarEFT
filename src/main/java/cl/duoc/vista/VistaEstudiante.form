<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.duoc.vista.VistaEstudiante">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="1af55" binding="panelMenu" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c10a8" class="javax.swing.JButton" binding="btnCatalogo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="180" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Ver Catalogo"/>
            </properties>
          </component>
          <component id="5b6ae" class="javax.swing.JButton" binding="btnMisPrestamos">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="180" height="40"/>
              </grid>
            </constraints>
            <properties>
              <text value="Mis Prestamos"/>
            </properties>
          </component>
          <component id="23559" class="javax.swing.JButton" binding="btnSalir">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Salir"/>
            </properties>
          </component>
          <vspacer id="7b6cc">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
        </children>
      </grid>
      <grid id="93cea" binding="panelContenedorCard" layout-manager="CardLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="e2f18" binding="tarjetaCatalogo" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <card name="Card1"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="92afe" class="javax.swing.JLabel" binding="lblCatalogo">
                <constraints border-constraint="North"/>
                <properties>
                  <text value="Catalogo de Libros"/>
                </properties>
              </component>
              <scrollpane id="ac989" binding="scrInventario">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="93c63" class="javax.swing.JTable" binding="tablaInventario">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <component id="9eb0f" class="javax.swing.JButton" binding="btnPedir">
                <constraints border-constraint="South"/>
                <properties>
                  <preferredSize width="150" height="35"/>
                  <text value="Pedir Prestamo"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
