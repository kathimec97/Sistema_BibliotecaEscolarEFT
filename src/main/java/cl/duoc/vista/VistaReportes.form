<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.duoc.vista.VistaReportes">
  <grid id="27dc6" binding="PanelReportes" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="15">
    <margin top="15" left="15" bottom="15" right="15"/>
    <constraints>
      <xy x="20" y="20" width="500" height="511"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="d5f0f" class="javax.swing.JLabel" binding="lblReporte">
        <constraints>
